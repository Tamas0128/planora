# PLANora — production docker-compose környezeti változók
#
# Másold ezt a fájlt `.env` néven a projekt gyökerébe, és töltsd ki
# minden CHANGE_ME értéket, MIELŐTT első alkalommal futtatod a
# `docker compose up --build -d` parancsot.
#
# A docker-compose.yml automatikusan beolvassa a gyökérkönyvtárban lévő
# `.env` fájlt — ezt a fájlt (.env.example) sosincs beolvasva közvetlenül,
# csak minta.

# --- PostgreSQL ---
POSTGRES_USER=planora
POSTGRES_PASSWORD=CHANGE_ME_erős_jelszó
POSTGRES_DB=planora

# --- MinIO (S3-kompatibilis dokumentum/fotó tároló) ---
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_erős_jelszó
# Csak akkor kell módosítani, ha a MinIO más gépről/porton érhető el, mint
# ahonnan a böngésző eléri az appot (pl. konténer belső hálózat vs. külső IP).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Backend ---
# Generálás: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_a_random_64char_hex_string
# Az admin fiók jelszava — ha üresen hagyod, a rendszer első indításkor
# véletlenszerű jelszót generál és kiírja a backend konténer logjába.
ADMIN_PASSWORD=CHANGE_ME_strong_password

# Vesszővel elválasztott lista — minden domain/port, ahonnan a böngésző
# eléri az alkalmazást (a frontend maga is ide tartozik, mert a böngésző
# az API-hívásokat is innen indítja). Írd át a saját domained/IP-d szerint,
# pl.: https://planora.pelda-cegem.hu,https://planora.pelda-cegem.hu:8443
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost,http://localhost:8080,https://localhost:8443,https://localhost
