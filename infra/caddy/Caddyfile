{
	# Caddy internal CA – generates a locally-trusted cert for localhost.
	# To make browsers trust it (one-time, needs admin):
	#   docker exec planora-https-local-1 caddy trust
	# Or manually import the CA:
	#   docker exec planora-https-local-1 cat /data/caddy/pki/authorities/local/root.crt > caddy-root.crt
	#   certutil -addstore -enterprise Root caddy-root.crt
}

https://localhost:443 {
	tls internal

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Everything goes through the frontend (Next.js proxies /api/* → backend internally)
	reverse_proxy frontend:3000 {
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
	}
}


https://localhost:9443 {
	tls internal

	# MinIO presigned URLs (avatars, CRM/project documents) proxied over HTTPS
	# on their own port — the app itself is served from :443 above, so this
	# stays a separate origin rather than a path prefix (MinIO's S3 API has
	# no notion of a path prefix; bucket/key must sit right after the host).
	# Host header is passed through unchanged (Caddy's default), which is
	# required for SigV4 verification since S3_PUBLIC_ENDPOINT signs the
	# presigned URL against this exact host:port.
	reverse_proxy minio:9000
}

# HTTP redirect nem lehetséges (port 80 a Docker host foglalja)
# Közvetlenül használd: https://localhost
