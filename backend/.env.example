# REQUIRED — change all values before production deployment
DATABASE_URL=postgresql://planora:CHANGE_ME@localhost:5432/planora
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_a_random_64char_hex_string
# Admin account initial password — set before first boot
ADMIN_PASSWORD=CHANGE_ME_strong_password
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME_minio_user
S3_SECRET_KEY=CHANGE_ME_minio_password
S3_BUCKET=planora-docs
CORS_ORIGINS=http://localhost:3000,http://localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@planora.local
SMTP_USE_TLS=true
DAILY_DIGEST_HOUR=7
DAILY_DIGEST_MINUTE=0
